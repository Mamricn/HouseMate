rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isHouseholdMember(householdId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/households/$(householdId)
        )
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/households/$(householdId)
        ).data.get('member_ids', []);
    }

    match /profile_images/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/jpeg')
                            && fileName.matches('avatar-[A-Za-z0-9-]+\\.jpg');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    match /household_documents/{householdId}/{documentId}/{fileName} {
      allow read: if isHouseholdMember(householdId);

      allow create: if isHouseholdMember(householdId)
                    && request.resource.size < 15 * 1024 * 1024
                    && fileName.size() > 0
                    && (
                      request.resource.contentType.matches('image/.*')
                      || request.resource.contentType == 'application/pdf'
                    );

      allow update: if false;
      allow delete: if isHouseholdMember(householdId);
    }
  }
}
